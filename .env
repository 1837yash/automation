# Copy this file to ".env" and fill in your values. Never share or commit .env

# Any secret text you invent. Must match what you type in Meta's webhook setup.
VERIFY_TOKEN=my_verify_token

# From Meta developer dashboard > WhatsApp > API Setup
ACCESS_TOKEN=paste_your_token_here
PHONE_NUMBER_ID=paste_phone_number_id_here

# Meta app > Settings > Basic > App secret (enables signature checking)
APP_SECRET=

# Password for /chats and /resume admin URLs
ADMIN_KEY=change-me

# Optional
GRAPH_VERSION=v23.0
PORT=5000
